# DEXTRA v2 — template produksi. Ganti semua placeholder sebelum deploy.
# JANGAN commit nilai sebenarnya.

DEXTRA_ENV=production

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/dextra

DEXTRA_AGENT_TOKEN=REPLACE_WITH_STRONG_TOKEN
DEXTRA_OPS_TOKEN=REPLACE_WITH_STRONG_TOKEN
DEXTRA_LEGACY_TENANT=dextra-demo

DEXTRA_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

DEXTRA_API_URL=https://api.example.com
DEXTRA_API_TOKEN=REPLACE_WITH_STRONG_TOKEN

# AI provider (opsional)
# DEXTRA_AI_API_KEY=sk-...
# DEXTRA_AI_BASE_URL=https://api.openai.com/v1
# DEXTRA_AI_MODEL=gpt-4o-mini

# SMTP (opsional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=dextra@example.com

# Telegram (opsional)
# TELEGRAM_BOT_TOKEN=

DEXTRA_MCP_PORT=8787
}