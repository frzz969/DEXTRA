# DEXTRA v2 — contoh konfigurasi. JANGAN commit .env yang berisi nilai sebenarnya.

# Database. PostgreSQL adalah target; SQLite hanya untuk pengembangan lokal.
DATABASE_URL=postgresql+psycopg://dextra:dextra@localhost:5432/dextra
# DATABASE_URL=sqlite+pysqlite:///./data/dextra-v2.db

# Token gateway MCP lama (apps/mcp-server) dan API baru. Ganti sebelum demo.
DEXTRA_AGENT_TOKEN=agent-dev-token
DEXTRA_OPS_TOKEN=ops-dev-token

# Tenant yang diwakili kedua token gateway di atas. Isi dengan slug tenant
# (mis. hasil seed: "dextra-demo"). Tanpa nilai ini, token gateway tidak
# melihat data ber-tenant sama sekali — sengaja gagal-tertutup, bukan global.
DEXTRA_LEGACY_TENANT=dextra-demo

# Origin yang diizinkan. Tidak ada wildcard: daftar eksplisit.
DEXTRA_ALLOWED_ORIGINS=http://127.0.0.1:8899,http://localhost:8899,http://127.0.0.1:3000,http://localhost:3000

DEXTRA_ENV=development

# Dipakai apps/web (server-side saja; token tidak dikirim ke browser).
DEXTRA_API_URL=http://127.0.0.1:8000
DEXTRA_API_TOKEN=ops-dev-token

# Provider AI untuk Assistant & Copilot (sama untuk keduanya). Tanpa key ini,
# kedua halaman tampil state "AI belum dikonfigurasi" — bukan jawaban pura-pura.
# OpenAI-compatible; provider bebas (OpenAI, DeepSeek, Qwen, Gemini-OpenAI, self-hosted).
# DEXTRA_AI_API_KEY=sk-...
# DEXTRA_AI_BASE_URL=https://api.openai.com/v1
# DEXTRA_AI_MODEL=gpt-4o-mini
