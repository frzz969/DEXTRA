{
  "mcpServers": {
    "dextra": {
      "url": "http://127.0.0.1:8765",
      "transport": "http",
      "auth": {
        "type": "bearer",
        "tokenEnv": "DEXTRA_AGENT_TOKEN"
      },
      "allowedTools": [
        "get_org_rules",
        "find_precedent",
        "create_plan",
        "validate_plan",
        "get_plan",
        "get_mandate",
        "get_status"
      ],
      "note": "Agent token only. Ops token (execute_action, submit_approval, issue_mandate, revoke_mandate) is never exposed to the agent (PRD §8.3, TC-010)."
    }
  }
}