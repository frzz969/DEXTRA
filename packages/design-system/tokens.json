{
  "$schema": "https://dextra.local/schemas/design-tokens.v1.json",
  "name": "dextra-design-system",
  "version": "0.1.0",
  "description": "Token inti DEXTRA. Setiap entri di sini diverifikasi terhadap packages/design-system/src/dashboard.css oleh scripts/verify-packages.mjs — token yang tidak dipakai CSS akan menggagalkan pemeriksaan.",
  "groups": {
    "brand": {
      "brand-700": "#4a2fbe",
      "brand-600": "#5b3fd6",
      "brand-500": "#7357e8",
      "brand-300": "#b9a8f7",
      "brand-100": "#efebff",
      "brand-050": "#f6f3ff"
    },
    "status": {
      "success-600": "#17845e",
      "success-100": "#e4f6ee",
      "warning-600": "#a96a11",
      "warning-100": "#fdf2df",
      "danger-600": "#c33a4c",
      "danger-100": "#fdecee",
      "info-600": "#2f6fc0",
      "info-100": "#e8f1fc"
    },
    "neutral": {
      "page": "#f5f5fa",
      "surface": "#ffffff",
      "surface-2": "#fafafd",
      "surface-3": "#f2f2f8",
      "border": "#e6e6ef",
      "border-strong": "#d6d6e4",
      "text": "#15152a",
      "text-2": "#45455c",
      "muted": "#6f6f88",
      "faint": "#9a9ab0"
    },
    "radius": {
      "r-xs": "4px",
      "r-sm": "6px",
      "r-md": "9px",
      "r-lg": "12px",
      "r-xl": "16px",
      "r-full": "999px"
    },
    "space": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "12px",
      "s-4": "16px",
      "s-5": "20px",
      "s-6": "24px",
      "s-8": "32px",
      "s-10": "40px",
      "s-12": "48px"
    },
    "layout": {
      "sidebar-w": "264px",
      "sidebar-w-collapsed": "76px",
      "topbar-h": "64px",
      "tabsbar-h": "40px",
      "content-max": "1440px"
    }
  },
  "typography": {
    "sans": "Inter",
    "display": "Plus Jakarta Sans",
    "mono": "system monospace",
    "scale": {
      "pageHeading": "28-32px",
      "sectionHeading": "18-20px",
      "body": "14-15px",
      "label": "12-13px",
      "dataValue": "24-30px"
    }
  },
  "themes": ["light", "dark", "system"],
  "notes": [
    "Light dan dark memakai kontrak token yang sama; blok dark hanya menimpa nilainya.",
    "Tidak ada token yang ditambahkan di sini tanpa dipakai CSS — pemeriksaan otomatis menolaknya."
  ]
}
