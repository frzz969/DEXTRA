﻿node_modules/
# Data kerja agen (catatan sesi lokal), bukan bagian dari produk
.workbuddy-ai/
# Next.js
apps/web/.next/
apps/web/next-env.d.ts
# Python
*.py[cod]
*.egg-info/
.venv/
venv/
# Database lokal hasil pengembangan/uji (bukan data produk)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# Keadaan runtime, bukan data produk.
# Checkpoint hanya bermakna bila dibaca bersama audit.jsonl di mesin yang sama;
# meng-commit-nya berarti membawa klaim "ini event terakhir" ke mesin lain,
# yang justru memicu truncated palsu.
data/audit.checkpoint.json
# Lockfile antar-proses (open 'wx'); sisa proses yang mati tidak boleh masuk repo.
data/*.lock
# Artefak ekspor audit. Hasil, bukan sumber: tiap ekspor punya id sendiri, dan
# meng-commit-nya berarti membawa potret audit ke mesin yang auditnya berbeda.
data/exports/
# Sisa kompilasi TypeScript
# Artefak sesi browser (Playwright MCP)
.playwright-mcp/
# Konfigurasi agen lokal (sama seperti .workbuddy-ai), bukan bagian dari produk
.codebuddy/

