FROM node:22-slim

WORKDIR /app

# apps/web sengaja punya node_modules sendiri: symlink workspace npm gagal di
# Windows, dan memisahkannya membuat kedua sisi konsisten di semua OS.
COPY packages ./packages
COPY scripts ./scripts
COPY apps/web ./apps/web

RUN node scripts/sync-packages.mjs

WORKDIR /app/apps/web
RUN npm install --no-audit --no-fund && npm run build

EXPOSE 3000
CMD ["npm", "start"]
