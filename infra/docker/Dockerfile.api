FROM python:3.13-slim

WORKDIR /app

COPY pyproject.toml ./
COPY backend ./backend
COPY database ./database
COPY apps/api ./apps/api

RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn>=0.30" "sqlalchemy>=2.0" \
    "psycopg[binary]>=3.2" "alembic>=1.13" "pydantic>=2.8"

ENV PYTHONPATH=/app/backend
EXPOSE 8000

# Migrasi dijalankan saat start supaya container tidak pernah melayani skema basi.
CMD ["sh", "-c", "alembic -c database/alembic.ini upgrade head && uvicorn dextra.main:app --host 0.0.0.0 --port 8000"]
