{
  "name": "dextra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DEXTRA — agen AI kantor dengan eksekusi berbasis mandat",
  "packageManager": "pnpm@12.10.1",
  "workspaces": [
    "packages/*",
    "apps/mcp-server",
    "apps/telegram-adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/verify-package-manager.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node scripts/verify-packages.mjs && node scripts/verify-workbuddy.mjs && pnpm -r --if-present run test",
    "test:all": "node scripts/test-all.mjs",
    "test:inproc": "node --test --experimental-strip-types \"packages/*/tests/*.test.ts\" \"apps/*/tests/*.test.ts\"",
    "test:dashboard": "node --test --experimental-strip-types \"apps/dashboard/tests/*.test.ts\"",
    "test:e2e": "pnpm --filter @dextra/web run test:e2e",
    "test:e2e:dashboard": "node apps/dashboard/tests/e2e/run.mjs",
    "test:http": "node --test --experimental-strip-types \"apps/mcp-server/tests/http-verification.verify.ts\"",
    "test:contracts": "pnpm --filter @dextra/contracts run test",
    "sync:packages": "node scripts/sync-packages.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "lint": "pnpm run typecheck && node scripts/check-syntax.mjs && pnpm run lint:dashboard",
    "lint:dashboard": "node scripts/lint-dashboard.mjs",
    "dev:dashboard": "node scripts/serve-dashboard.mjs",
    "demo:seed": "node --experimental-strip-types packages/store/src/seed.ts",
    "demo:reset": "node --experimental-strip-types packages/store/src/seed.ts --reset",
    "demo:flow": "node scripts/demo-flow.mjs",
    "dev:mcp": "node --experimental-strip-types apps/mcp-server/src/index.ts",
    "dev:telegram": "node --experimental-strip-types apps/telegram-adapter/index.ts",
    "dev:web": "./scripts/dev-web.sh",
    "alerts:scan": "node --experimental-strip-types packages/alerts/src/cli.ts --once",
    "audit:verify": "node --experimental-strip-types packages/audit-export/src/cli.ts"
  }
}
