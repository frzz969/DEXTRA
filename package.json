{
  "name": "dextra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DEXTRA — agen AI kantor dengan eksekusi berbasis mandat",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:inproc": "node --test --experimental-strip-types --experimental-test-isolation=none \"packages/*/tests/*.test.ts\" \"apps/*/tests/*.test.ts\"",
    "test:contracts": "npm run test --workspace @dextra/contracts"
  }
}
